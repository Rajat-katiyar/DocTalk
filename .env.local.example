# Copy this file to .env.local and fill in your own values.
# Never commit real secrets to this file.

# MongoDB connection string — get it from Atlas (or your local cluster)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/DocTalk?appName=Cluster0"

# NextAuth — generate a strong random string with `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"
